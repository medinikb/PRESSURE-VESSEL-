  "calculation_modules": {
    "cylindrical_shell_Do_over_t_greater_or_equal_10": {
      "applicability": "Do_over_t >= 10",
      "steps": [
        {
          "step": 1,
          "calculate": [
            "L_over_Do = L / Do",
            "Do_over_t = Do / t"
          ]
        },
        {
          "step": 2,
          "calculate": "A = lookup_Figure_G(L_over_Do, Do_over_t) using the controlled chart dataset and chart boundary rules."
        },
        {
          "step": 3,
          "calculate": "B_or_elastic_region = lookup_material_chart(chart_id, A, design_temperature)"
        },
        {
          "step": 4,
          "condition": "factor_B_resolved",
          "formula_id": "UG28_CYLINDER_INELASTIC",
          "formula": "Pa = 4 * B / (3 * (Do / t))",
          "javascript_expression": "Pa = (4 * B) / (3 * (Do / t))"
        },
        {
          "step": 5,
          "condition": "A_left_of_material_temperature_curve",
          "formula_id": "UG28_CYLINDER_ELASTIC",
          "formula": "Pa = 2 * A * E / (3 * (Do / t))",
          "javascript_expression": "Pa = (2 * A * E) / (3 * (Do / t))"
        },
        {
          "step": 6,
          "acceptance": "pass when Pa >= P"
        }
      ]
    },
    "cylindrical_shell_Do_over_t_less_than_10": {
      "applicability": "Do_over_t < 10",
      "steps": [
        {
          "step": 1,
          "condition": "Do_over_t < 4",
          "formula_id": "UG28_THICK_CYLINDER_A",
          "formula": "A = 1.1 / (Do / t)^2",
          "cap": "A <= 0.10",
          "javascript_expression": "A = Math.min(0.10, 1.1 / Math.pow(Do / t, 2))"
        },
        {
          "step": 2,
          "calculate": "Resolve factor B from the assigned material chart using factor A and design temperature."
        },
        {
          "step": 3,
          "formula_id": "UG28_THICK_CYLINDER_PA1",
          "formula": "Pa1 = ((2.167 / (Do / t)) - 0.0833) * B",
          "javascript_expression": "Pa1 = ((2.167 / (Do / t)) - 0.0833) * B"
        },
        {
          "step": 4,
          "formula_id": "UG28_THICK_CYLINDER_S",
          "formula": "S = min(2 * allowable_tensile_stress, 0.9 * yield_strength_at_temperature)",
          "javascript_expression": "S = Math.min(2 * allowableTensileStress, 0.9 * yieldStrengthAtTemperature)"
        },
        {
          "step": 5,
          "formula_id": "UG28_THICK_CYLINDER_PA2",
          "formula": "Pa2 = (2 * S / (Do / t)) * (1 - 1 / (Do / t))",
          "javascript_expression": "Pa2 = (2 * S / (Do / t)) * (1 - 1 / (Do / t))"
        },
        {
          "step": 6,
          "formula_id": "UG28_THICK_CYLINDER_GOVERNING",
          "formula": "Pa = min(Pa1, Pa2)",
          "javascript_expression": "Pa = Math.min(Pa1, Pa2)"
        },
        {
          "step": 7,
          "acceptance": "pass when Pa >= P"
        }
      ]
    },
    "spherical_shell_and_hemispherical_head": {
      "geometry": "Ro = outside spherical radius",
      "steps": [
        {
          "step": 1,
          "formula_id": "UG28_SPHERE_A",
          "formula": "A = 0.125 / (Ro / t)^2",
          "javascript_expression": "A = 0.125 / Math.pow(Ro / t, 2)"
        },
        {
          "step": 2,
          "calculate": "Resolve factor B or elastic-region status from the assigned material chart using A and design temperature."
        },
        {
          "step": 3,
          "condition": "factor_B_resolved",
          "formula_id": "UG28_SPHERE_INELASTIC",
          "formula": "Pa = B / (Ro / t)",
          "javascript_expression": "Pa = B / (Ro / t)"
        },
        {
          "step": 4,
          "condition": "A_left_of_material_temperature_curve",
          "formula_id": "UG28_SPHERE_ELASTIC",
          "formula": "Pa = 0.0625 * E / (Ro / t)^2",
          "javascript_expression": "Pa = (0.0625 * E) / Math.pow(Ro / t, 2)"
        },
        {
          "step": 5,
          "acceptance": "pass when Pa >= P"
        }
      ]
    },
    "ellipsoidal_head": {
      "geometry_steps": [
        {
          "step": 1,
          "formula": "shape_ratio = Do / (2 * ho)"
        },
        {
          "step": 2,
          "formula": "Ko = interpolate_UG_33_1(shape_ratio)"
        },
        {
          "step": 3,
          "formula_id": "UG33_ELLIPSOIDAL_EQUIVALENT_RADIUS",
          "formula": "Ro = Ko * Do",
          "javascript_expression": "Ro = Ko * Do"
        }
      ],
      "buckling_steps": "Use the spherical-shell and hemispherical-head module with the equivalent outside spherical radius Ro = Ko * Do.",
      "special_rule": "For a standard 2:1 ellipsoidal head, Do/(2ho) = 2.0 and Ko = 0.90."
    },
    "torispherical_head": {
      "geometry": "Ro = outside crown radius",
      "buckling_steps": "Use the spherical-shell and hemispherical-head module with Ro equal to the outside crown radius.",
      "additional_review": [
        "Verify knuckle geometry.",
        "Verify minimum thickness after forming.",
        "Verify formed-head tolerances."
      ]
    }
  },
  "thickness_selection_algorithm": {
    "preferred_method": "commercial_candidate_thickness_iteration",
    "reason": "External-pressure capacity depends on chart lookups and thickness-dependent geometry; direct algebraic inversion is not reliable.",
    "candidate_iteration": {
      "inputs": [
        "sorted_nominal_thickness_candidates_mm",
        "corrosion_allowance_mm",
        "forming_thinning_allowance_mm_if_head"
      ],
      "procedure": [
        "For each candidate nominal thickness in ascending order, calculate effective thickness.",
        "Recalculate outside geometry if inside diameter is the fixed design dimension.",
        "Calculate the applicable ratios and factor A.",
        "Resolve factor B or modulus E from controlled chart data.",
        "Calculate allowable external pressure Pa.",
        "Reject candidate when Pa < P.",
        "Select the first candidate for which Pa >= P.",
        "Recalculate the selected candidate as the final verification pass."
      ],
      "no_passing_candidate_result": "external_pressure_thickness_not_resolved"
    },
    "numeric_fallback": {
      "enabled": true,
      "method": "incremental_search_then_round_up",
      "default_start_thickness_mm": 3.0,
      "default_increment_mm": 0.5,
      "default_maximum_thickness_mm": 200.0,
      "maximum_iterations": 1000,
      "final_action": "Round upward to the next approved commercial thickness and repeat the full calculation."
    },
    "stiffening_ring_option": {
      "trigger": "No practical shell thickness passes, or shell thickness is economically excessive.",
      "action": "Reduce unsupported length using a proposed qualified stiffening ring arrangement, then recalculate the shell.",
      "automatic_ring_design_included": false,
      "blocking_note": "The ring section and attachment must be separately checked under UG-29 and UG-30 before the ring is accepted as a line of support."
    }
  },
