      "external_pressure_difference_mpa": 0.101325,
      "basis": "standard_atmospheric_pressure_at_sea_level",
      "mandatory_user_confirmation": true,
      "warning": "Site altitude, steam-out, jacket pressure and project design basis may require a different external design pressure."
    },
    "shell_effective_thickness_basis": {
      "default_rule": "t_effective = t_nominal - corrosion_allowance",
      "app_expression": "t_effective_mm = t_nominal_mm - corrosion_allowance_mm",
      "additional_project_deductions": "Apply only when explicitly required by the project-controlled basis. Do not silently subtract mill tolerance."
    },
    "head_effective_thickness_basis": {
      "preferred_input": "minimum_available_thickness_after_forming",
      "fallback_FEED_rule": "t_after_forming_available = t_blank_nominal - forming_thinning_allowance - corrosion_allowance",
      "app_expression": "t_effective_mm = t_blank_nominal_mm - forming_thinning_allowance_mm - corrosion_allowance_mm"
    },
    "unsupported_length": {
