  "recommended_FEED_defaults": {
    "plate_nesting_and_trim_factor": 1.08,
    "forming_premium_percent": 12,
    "overlay_overdeposit_factor": 1.2,
    "labor_hours_per_machine_hour": 1.25,
    "weld_overlay_repair_percent": 5,
    "lining_nesting_factor": 1.12,
    "freight_percent": 3,
    "vendor_overhead_and_profit_percent": 12,
    "contingency_percent": 15,
    "note": "These are editable estimating assumptions, not Code requirements or supplier quotations."
  },
  "geometry_weight_formulas": {
    "shell_area_m2": "pi * shell_inside_diameter_m * clad_shell_length_m",
    "two_to_one_ellipsoidal_head": {
      "variables": {
        "a": "inside_diameter_m / 2",
        "c": "inside_diameter_m / 4",
        "e": "sqrt(1 - (c*c)/(a*a))"
      },
      "area_formula": "pi * a^2 * (1 + ((c*c)/(a*a*e)) * atanh(e))"
    },
    "hemispherical_head_area_m2": "2 * pi * inside_radius_m^2",
    "flat_head_area_m2": "pi * inside_diameter_m^2 / 4",
    "straight_flange_area_m2": "pi * inside_diameter_m * straight_flange_length_m",
    "torispherical_head_area_m2": "use_app_geometry_engine_or_user_input",
    "nozzle_bore_area_each_m2": "pi * nozzle_inside_diameter_m * clad_length_m",
    "gross_clad_area_m2": "(shell_area + total_head_area + additional_clad_area + nozzle_area + internal_attachment_area) * coverage_percent / 100 - excluded_area",
    "finished_cladding_mass_kg": "gross_clad_area_m2 * ((finished_cladding_thickness_mm + cladding_corrosion_allowance_mm) / 1000) * density_kg_m3",
    "integral_clad_procurement_mass_kg": "finished_cladding_mass_kg * plate_nesting_and_trim_factor",
    "weld_overlay_deposited_mass_kg": "gross_clad_area_m2 * ((finished_thickness_mm + cladding_corrosion_allowance_mm + fabrication_or_machining_loss_mm) / 1000) * density_kg_m3 * overlay_overdeposit_factor",
    "weld_overlay_consumable_mass_kg": "weld_overlay_deposited_mass_kg / deposition_efficiency",
    "weld_overlay_machine_hours": "weld_overlay_deposited_mass_kg / deposition_rate_kg_per_machine_hour",
    "weld_overlay_labor_hours": "weld_overlay_machine_hours * labor_hours_per_machine_hour",
    "applied_lining_purchase_mass_kg": "finished_cladding_mass_kg * lining_nesting_factor",
    "reported_added_vessel_weight": {
      "integral_cladding": "finished_cladding_mass_kg + local_restoration_finished_mass_kg",
      "weld_overlay": "finished_cladding_mass_kg + local_restoration_finished_mass_kg",
      "applied_lining": "finished_cladding_mass_kg + attachment_weld_mass_kg"
    }
  },
  "cost_formulas": {
    "integral_clad_plate": {
      "vendor_rate_mode": {
        "composite_plate_weight_kg": "base_plate_purchase_mass_kg + integral_clad_procurement_mass_kg",
        "purchase_cost": "composite_plate_weight_kg * composite_clad_plate_rate_per_kg"
      },
      "build_up_mode": {
        "base_plate_cost": "base_plate_purchase_mass_kg * base_plate_rate_per_kg",
        "CRA_layer_cost": "integral_clad_procurement_mass_kg * CRA_plate_rate_per_kg",
        "bonding_cost": "gross_clad_area_m2 * bonding_premium_per_m2",
        "forming_cost": "(base_plate_cost + CRA_layer_cost + bonding_cost) * forming_premium_percent / 100",
        "bond_examination_cost": "gross_clad_area_m2 * bond_examination_cost_per_m2",
        "subtotal": "base_plate_cost + CRA_layer_cost + bonding_cost + forming_cost + bond_examination_cost"
      }
    },
    "weld_overlay": {
      "consumable_cost": "weld_overlay_consumable_mass_kg * weld_consumable_rate_per_kg",
      "machine_cost": "weld_overlay_machine_hours * machine_rate_per_hour",
      "labor_cost": "weld_overlay_labor_hours * direct_labor_rate_per_hour",
      "surface_preparation_cost": "gross_clad_area_m2 * surface_preparation_cost_per_m2",
      "grinding_cost": "gross_clad_area_m2 * grinding_or_machining_cost_per_m2",
      "repair_cost": "(consumable_cost + machine_cost + labor_cost) * repair_percent / 100",
      "subtotal": "consumable_cost + machine_cost + labor_cost + surface_preparation_cost + grinding_cost + repair_cost"
    },
    "applied_lining": {
      "sheet_cost": "applied_lining_purchase_mass_kg * lining_sheet_rate_per_kg",
      "installation_labor_cost": "gross_clad_area_m2 * lining_installation_labor_hours_per_m2 * direct_labor_rate_per_hour",
      "attachment_weld_cost": "attachment_weld_length_m * attachment_weld_cost_per_m",
      "subtotal": "sheet_cost + installation_labor_cost + attachment_weld_cost + tightness_test_cost_lump_sum + vent_telltale_detail_cost_lump_sum"
    },
    "common": {
      "weld_restoration_cost": "weld_seam_restoration_length_m * weld_restoration_cost_per_m",
      "QA_NDE_cost": "PMI_cost_lump_sum + PT_cost_lump_sum + ferrite_or_chemistry_test_cost_lump_sum",
      "technical_cost": "PWHT_cladding_impact_cost_lump_sum + engineering_and_procedure_qualification_cost_lump_sum",
      "direct_cost": "selected_option_subtotal + weld_restoration_cost + QA_NDE_cost + technical_cost",
      "freight_cost": "direct_cost * freight_percent / 100 unless included",
      "vendor_overhead_profit": "(direct_cost + freight_cost) * vendor_overhead_and_profit_percent / 100",
      "pre_contingency_cost": "direct_cost + freight_cost + vendor_overhead_profit",
      "contingency": "pre_contingency_cost * contingency_percent / 100",
      "FEED_total_cost_excluding_tax": "pre_contingency_cost + contingency"
    }
  },
