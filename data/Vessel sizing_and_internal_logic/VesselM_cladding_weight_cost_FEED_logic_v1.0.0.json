    "currency_conversion_formula": "converted_rate = source_rate * approved_exchange_rate",
    "location_adjustment_formula": "location_adjusted_rate = converted_or_escalated_rate * location_factor"
  },
  "automation_rules": {
    "default_strength_route": "base_carbon_steel_only",
    "recommendations": [
